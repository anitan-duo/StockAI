# StockAI Backend
# ===========================
# Database
# ===========================
DATABASE_URL=postgresql+asyncpg://stockai:stockai@localhost:5432/stockai

# ===========================
# Valkey (Redis-compatible)
# ===========================
VALKEY_URL=redis://localhost:6379/0
# Docker: VALKEY_URL=redis://valkey:6379/0
REDIS_URL=redis://localhost:6379/0

# ===========================
# Security
# ===========================
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is intentionally rejected by config validation.
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# API
# ===========================
API_V1_PREFIX=/api/v1
PROJECT_NAME=StockAI
DEBUG=false

# ===========================
# Trusted hosts / CORS
# ===========================
# Comma-separated Host values allowed by TrustedHostMiddleware (host:port ok).
# Production: set to the public hostname(s) only, e.g. api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================
# Market Data Provider - Global
# ===========================
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER_ORDER=alphavantage,twelvedata,finnhub

# Google Finance (fallback only, no API key required, uses scraping)
GOOGLE_FINANCE_ENABLED=false
GOOGLE_FINANCE_API_KEY=
GOOGLE_FINANCE_RATE_LIMIT=100

# Finnhub
FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_RATE_LIMIT=60

# TwelveData
TWELVE_DATA_ENABLED=false
TWELVE_DATA_API_KEY=
TWELVE_DATA_RATE_LIMIT=800
# Alias for config compatibility
TWELVEDATA_ENABLED=false
TWELVEDATA_API_KEY=
TWELVEDATA_RATE_LIMIT=800

# Alpha Vantage
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_RATE_LIMIT=5
# Alias (ALPHAVANTAGE_* accepted for backward compatibility)
ALPHAVANTAGE_ENABLED=false
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_RATE_LIMIT=5

# FRED (macro/econ series; optional)
FRED_API_KEY=

# Yahoo Finance (no API key)
YAHOO_FINANCE_ENABLED=false
YAHOO_FINANCE_RATE_LIMIT=100
YAHOO_ENABLED=false
YAHOO_RATE_LIMIT=100

# Valkey
VALKEY_ENABLED=true

# ===========================
# Ingestion
# ===========================
INGESTION_INTERVAL_MINUTES=5
INGESTION_BATCH_SIZE=100
INGESTION_RETRY_ATTEMPTS=3
INGESTION_TIMEOUT_SECONDS=30

# ===========================
# Scheduler (asyncio tasks in API lifespan, Valkey-locked)
# ===========================
SCHEDULER_ENABLED=true
SCHEDULER_QUOTES_SECONDS=300
SCHEDULER_ALERTS_SECONDS=300
SCHEDULER_PREDICTIONS_SECONDS=3600
SCHEDULER_HISTORY_SECONDS=21600
SCHEDULER_OUTCOMES_SECONDS=3600
SCHEDULER_MONITORING_SECONDS=3600
SCHEDULER_EVOLUTION_SECONDS=86400
SCHEDULER_SHADOW_SECONDS=3600
SCHEDULER_RANKING_SECONDS=21600

# ===========================
# Auth throttling (per IP+email)
# ===========================
AUTH_LOGIN_MAX_ATTEMPTS=30
AUTH_REGISTER_MAX_ATTEMPTS=30
AUTH_THROTTLE_WINDOW_SECONDS=900

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================
# Prediction
# ===========================
PREDICTION_HORIZON_HOURS=24
PREDICTION_MODEL_VERSION=ensemble-v1.0
